PORT=3000
DATABASE_URL=postgres://jusmine:jusmine@localhost:5434/jusmine_clinic

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5180

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# Shared accounts (see hand-off: one Employee, one Manager)
EMPLOYEE_USERNAME=employee
EMPLOYEE_PASSWORD=change-me
MANAGER_USERNAME=manager
MANAGER_PASSWORD=change-me

# Timezone used for "today", "this month" and chart buckets
APP_TIMEZONE=Asia/Bangkok
