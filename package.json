    "db:seed:demo": "bun src/db/seed.ts --demo"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
